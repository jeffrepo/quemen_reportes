<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Vista del wizard -->
    <record id="view_form_quemen_reporte_metas_wizard" model="ir.ui.view">
      <field name="name">view.form.quemen_reportes.reporte_metas_wizard</field>
      <field name="model">quemen_reportes.reporte_metas.wizard</field>
      <field name="arch" type="xml">
        <form string="Reporte metas">
          <group>
            <field name="fecha_inicio"/>
            <field name="fecha_final"/>
            <field name="tienda_ids"/>
          </group>
          <group>
            <field name="name" invisible="1"/>
            <field name="archivo" readonly="1" filename="name"/>
          </group>
          <footer>
            <button name="generando_excel"
                    string="Reporte excel"
                    type="object"
                    class="oe_highlight"/>
            <button string="Cancel"
                    class="btn-default"
                    special="cancel"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Acción (forma correcta en Odoo 19) -->
    <record id="action_reporte_metas" model="ir.actions.act_window">
      <field name="name">Generar informe reporte de metas</field>
      <field name="res_model">quemen_reportes.reporte_metas.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="view_id" ref="view_form_quemen_reporte_metas_wizard"/>
    </record>

    <!-- Menú (después de la acción) -->
    <menuitem id="quemen_reporte_metas"
              name="Reporte metas"
              parent="point_of_sale.menu_point_rep"
              action="action_reporte_metas"
              sequence="65"/>

  </data>
</odoo>
